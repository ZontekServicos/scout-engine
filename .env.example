DATABASE_URL=postgresql://example_user:example_password@localhost:5432/example_database
SUPABASE_JWT_SECRET=example-supabase-jwt-secret
SUPABASE_URL=https://example-project.supabase.co
SPORTMONKS_API_TOKEN=example-sportmonks-token
OPENAI_API_KEY=example-openai-key
PORT=3000
NODE_ENV=development

# Opcionais
RATE_LIMIT_MAX=200
CACHE_TTL_SECONDS=120
CACHE_CHECK_PERIOD_SECONDS=60
CORS_ORIGINS=http://localhost:5173
USE_DB_CACHE=false
COMPARE_DEBUG=false
OVERALL_DEBUG=0
DB_BACKFILL_BATCH_SIZE=250
DB_BACKFILL_CONCURRENCY=10
