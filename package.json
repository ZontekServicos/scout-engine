{
  "name": "scout-engine",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node ./src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "jest tests/client",
    "test:strategy": "jest tests/strategy",
    "test:pipeline": "jest tests/pipeline",
    "test:failure": "jest tests/failure",
    "db:check": "ts-node scripts/checkDbConsistency.ts",
    "db:check:analysis": "ts-node scripts/checkAnalysisReadiness.ts",
    "db:backfill": "ts-node scripts/backfillAnalyticalSnapshots.ts",
    "import:players": "ts-node scripts/importPlayers.ts",
    "import:fc26": "ts-node scripts/import_fc26_players.ts",
    "update:positions": "ts-node scripts/updatePlayerPositions.ts",
    "seed:brazil": "cross-env NODE_ENV=development ts-node prisma/seed-brazil.ts",
    "seed:global": "cross-env NODE_ENV=development ts-node prisma/seed-global.ts",
    "seed:leagues": "cross-env NODE_ENV=development ts-node prisma/seed-leagues.ts",
    "seed:brazil:validated": "cross-env NODE_ENV=development ts-node prisma/seed-brazil-validated.ts",
    "parse:leagues": "ts-node src/scripts/parse-leagues.ts",
    "validate:brazil": "ts-node src/scripts/validate-brazil-leagues.ts",
    "validate:api": "ts-node src/scripts/validate-api.ts",
    "validate:api:debug": "ts-node src/scripts/validate-api.ts --debug",
    "validate:api:leagues": "ts-node src/scripts/validate-api.ts --leagues",
    "detect:capabilities": "ts-node src/scripts/detect-league-capabilities.ts",
    "detect:capabilities:refresh": "ts-node src/scripts/detect-league-capabilities.ts --refresh",
    "detect:capabilities:cached": "ts-node src/scripts/detect-league-capabilities.ts --cached",
    "enrich:images": "ts-node src/scripts/enrich-player-images.ts",
    "enrich:images:dry": "ts-node src/scripts/enrich-player-images.ts --dry-run",
    "enrich:images:phase1": "ts-node src/scripts/enrich-player-images.ts --phase1-only",
    "enrich:images:phase2": "ts-node src/scripts/enrich-player-images.ts --phase2-only"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/cors": "^2.8.19",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "node-cache": "^5.1.2",
    "openai": "^6.22.0",
    "p-limit": "^3.1.0",
    "prisma": "^6.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
