    "enrich:global:south-america": "npm run enrich:multi:argentina && npm run enrich:multi:chile && npm run enrich:multi:colombia",
    "enrich:global:all": "npm run enrich:global:europe:top5 && npm run enrich:global:europe:mid && npm run enrich:global:south-america",
