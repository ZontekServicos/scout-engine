    "enrich:multi:belgian": "ts-node src/scripts/enrich-multi-season.ts --seasons=25600,25145 --force",
    "enrich:multi:superlig": "ts-node src/scripts/enrich-multi-season.ts --seasons=25682,25168 --force",
    "enrich:multi:argentina": "ts-node src/scripts/enrich-multi-season.ts --seasons=26808,25807 --force",
    "enrich:multi:chile": "ts-node src/scripts/enrich-multi-season.ts --seasons=26873,25852 --force",
    "enrich:multi:colombia": "ts-node src/scripts/enrich-multi-season.ts --seasons=26881,25880 --force",
