generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  nameNormalized  String

  positions       String[]
  age             Int
  nationality     String

  team            String?
  league          String?
  imagePath       String?  @map("image_path")

  marketValue     Float?
  contractEnd     DateTime?

  overall         Int?
  potential       Int?

  attributes  Json
  archetype   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scoutReports ScoutReport[]

  @@index([nameNormalized])
  @@index([league])
  @@index([team])
  @@index([overall(sort: Desc)])
  @@index([potential(sort: Desc)])
  @@index([positions], type: Gin)
}

model ScoutReport {
  id          String   @id @default(uuid())
  playerId    String
  type        ScoutType

  input       Json
  output      Json
  risk        Json?
  aiNarrative String?  @db.Text

  // 🔵 GOVERNANÇA & AUDITORIA
  requestedBy     String?
  decisionBy      String?
  decisionReason  String? @db.Text
  decisionDate    DateTime?
  modelVersion    String?
  riskVersion     String?
  antiFlopVersion String?
  engineVersion   String?
  technicalReason String? @db.Text
  decisionStatus  DecisionStatus @default(PENDING)
  decisionAt      DateTime?

  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([type])
  @@index([createdAt])
  @@index([decisionStatus])
}

enum ScoutType {
  SINGLE
  COMPARE
  RANKING
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
}
