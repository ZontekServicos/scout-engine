generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core player/analysis models (existing — untouched)
// ---------------------------------------------------------------------------

model Player {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  nameNormalized  String
  source          String   @default("manual")
  externalId      String?

  positions       String[]
  age             Int
  nationality     String

  team            String?
  league          String?
  imagePath       String?  @map("image_path")
  /**
   * true  = we already attempted a Sportmonks image fetch for this player.
   *         Prevents re-fetching players whose image is genuinely unavailable.
   * false = never fetched (default) — eligible for enrichment.
   */
  imageFetched    Boolean  @default(false)

  // Physical profile — sourced from Sportmonks player endpoint
  height          Int?     // cm
  weight          Int?     // kg
  foot            String?  // "left" | "right" | "both"

  marketValue     Float?
  contractEnd     DateTime?

  overall         Int?
  potential       Int?
  // Calculated overall breakdown by attribute group (0-100 each)
  overallPace       Int?
  overallShooting   Int?
  overallPassing    Int?
  overallDribbling  Int?
  overallDefending  Int?
  overallPhysical   Int?
  overallGkDiving   Int?
  overallGkHandling Int?
  overallGkKicking  Int?
  overallGkReflex   Int?
  overallGkPositioning Int?
  // When the overall was last recalculated from stats
  overallCalculatedAt DateTime?

  // SoccerMind DNA — five-dimensional profile score (impact, intelligence, defensiveIQ, consistency, potential)
  dnaScore            Json?
  dnaCalculatedAt     DateTime?

  attributes  Json
  archetype   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comparisonEntries  AnalysisComparison[]
  metricsSnapshots   PlayerMetrics[]
  financialSnapshots PlayerFinancials[]
  riskSnapshots      PlayerRiskSnapshot[]
  statsSnapshots     PlayerStats[]
  matchEvents        MatchEvent[]

  // Sportmonks team link (separate from denormalized `team` string above)
  teamDbId           String?
  dbTeam             Team?    @relation(fields: [teamDbId], references: [id])

  @@index([nameNormalized])
  @@index([league])
  @@index([team])
  @@index([overall(sort: Desc)])
  @@index([potential(sort: Desc)])
  @@index([source])
  @@unique([source, externalId])
  @@index([positions], type: Gin)
  @@index([imageFetched])           // fast lookup for enrichment queue
  @@index([imagePath, imageFetched]) // partial scan: WHERE imagePath IS NULL AND imageFetched = false
}

model PlayerMetrics {
  id         String   @id @default(uuid())
  playerId   String
  overall    Int
  potential  Int
  pace       Int
  shooting   Int
  passing    Int
  defending  Int
  physical   Int
  dribbling  Int?
  timestamp  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerFinancials {
  id                   String   @id @default(uuid())
  playerId             String
  marketValue          Float?
  salary               Float?
  transferCostEstimate Float?
  contractYears        Int?
  timestamp            DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerRiskSnapshot {
  id             String   @id @default(uuid())
  playerId       String
  structuralRisk Float
  financialRisk  Float
  liquidityScore Float
  compositeRisk  Float
  riskLevel      RiskLevel
  explanation    String?  @db.Text
  timestamp      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([riskLevel])
  @@index([timestamp])
}

model Analysis {
  id          String             @id @default(cuid())
  type        AnalysisType
  title       String
  description String?            @db.Text
  payload     Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  status      AnalysisStatus     @default(COMPLETED)
  analyst     String?

  comparisons AnalysisComparison[]

  @@index([type])
  @@index([createdAt])
  @@index([status])
}

model AnalysisComparison {
  id         String   @id @default(uuid())
  analysisId String
  playerId   String
  order      Int

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([playerId])
  @@unique([analysisId, order])
  @@unique([analysisId, playerId])
}

// ---------------------------------------------------------------------------
// Ingestion hierarchy — Country → League → Season → Team → Player
// ---------------------------------------------------------------------------

model Country {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks country ID
  name       String
  iso2       String?
  flagPath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leagues    League[]
  teams      Team[]

  @@index([name])
}

model League {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks league ID
  name       String
  countryId  String?
  country    Country? @relation(fields: [countryId], references: [id])
  type       String?  // e.g. "domestic", "cup", "continental"
  logoPath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seasons    Season[]

  @@index([name])
  @@index([countryId])
}

model Season {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks season ID
  name       String
  leagueId   String?
  league     League?  @relation(fields: [leagueId], references: [id])
  year       Int?
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teams        Team[]        @relation("SeasonTeams")
  matches      Match[]
  playerStats  PlayerStats[]

  @@index([leagueId])
  @@index([isCurrent])
  @@index([year])
}

model Team {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks team ID
  name       String
  shortCode  String?           // e.g. "MCI", "FCB"
  logoPath   String?           // CDN URL from Sportmonks
  countryId  String?
  country    Country? @relation(fields: [countryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  players     Player[]
  seasons     Season[]    @relation("SeasonTeams")
  homeMatches Match[]     @relation("HomeMatches")
  awayMatches Match[]     @relation("AwayMatches")
  matchEvents MatchEvent[] @relation("TeamMatchEvents")

  @@index([name])
}

model PlayerStats {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Link to structured Season (optional — backward compatible with old string `season`)
  seasonId    String?
  dbSeason    Season?  @relation(fields: [seasonId], references: [id])
  season      String?  // denormalized label e.g. "2024/2025" — kept for compatibility

  source      String   @default("sportmonks") // sportmonks | manual

  // Scoring
  goals         Int?
  assists       Int?

  // Shooting
  shots         Int?
  shotsOnTarget Int?
  xG            Float?
  xA            Float?
  xGChain       Float?
  xGBuildup     Float?

  // Passing
  passes              Int?
  passAccuracy        Float?
  keyPasses           Int?
  progressivePasses   Int?
  longPasses          Int?
  longPassAccuracy    Float?
  crosses             Int?
  crossAccuracy       Float?

  // Dribbling & Carrying
  dribblesAttempted   Int?
  dribblesSuccess     Int?
  carries             Int?
  progressiveCarries  Int?

  // Defensive
  tackles       Int?
  tacklesWon    Int?
  interceptions Int?
  clearances    Int?
  blocks        Int?
  pressures     Int?
  pressuresSuccess Int?
  recoveries    Int?

  // Duels
  duelsTotal    Int?
  duelsWon      Int?
  aerialDuelsTotal Int?
  aerialDuelsWon   Int?
  groundDuelsWon   Int?

  // Discipline
  yellowCards   Int?
  redCards      Int?
  foulsCommitted Int?
  foulsDrawn    Int?

  // Goalkeeping
  saves         Int?
  savePct       Float?
  cleanSheets   Int?
  goalsConceded Int?

  // Physical
  distanceCovered Float?
  sprints         Int?
  rating          Float?
  minutes         Int?
  appearances     Int?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([seasonId])
  @@index([season])
}

// ---------------------------------------------------------------------------
// Match layer — Season → Match → MatchEvent
// ---------------------------------------------------------------------------

model Match {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks fixture ID
  seasonId   String?
  season     Season?  @relation(fields: [seasonId], references: [id])

  homeTeamId String?
  homeTeam   Team?    @relation("HomeMatches", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?    @relation("AwayMatches", fields: [awayTeamId], references: [id])

  homeScore  Int?
  awayScore  Int?
  startingAt DateTime?
  status     String?  // e.g. "FT", "NS", "LIVE", "HT"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events     MatchEvent[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([startingAt])
  @@index([status])
}

model MatchEvent {
  id         String  @id @default(uuid())
  externalId Int?    @unique // Sportmonks event ID (nullable — some events have no ID)
  // Deterministic hash for events without an externalId (SHA-256, 32 chars).
  // Enables skipDuplicates for synthetic events. PostgreSQL enforces uniqueness
  // via a partial unique index (WHERE "sourceHash" IS NOT NULL) in migration SQL.
  sourceHash String?          // not @unique here — partial index lives in SQL

  matchId    String
  match      Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId   String?
  player     Player? @relation(fields: [playerId], references: [id])

  teamId     String?
  team       Team?   @relation("TeamMatchEvents", fields: [teamId], references: [id])

  // Event classification
  type       String  // GOAL | SHOT | PASS | TACKLE | INTERCEPTION | DRIBBLE |
                     // YELLOW_CARD | RED_CARD | SUBSTITUTION | FOUL | SAVE | CLEARANCE

  // Timing
  minute      Int?
  extraMinute Int?

  // Spatial data — pitch coordinates normalised to 0–100
  // Used for: heatmap, shot map, pass map, defensive event map
  x    Float?  // start x (0=left, 100=right)
  y    Float?  // start y (0=bottom, 100=top)
  endX Float?  // end x (for passes, shots, dribbles)
  endY Float?  // end y

  // Outcome
  outcome String? // SUCCESS | FAIL | BLOCKED | SAVED | OFF_TARGET | ON_TARGET

  // Extra unstructured data (body part, assist type, VAR, etc.)
  meta Json?

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type])
  @@index([minute])
  // Composite index for spatial queries (heatmap per player/type)
  @@index([playerId, type])
  @@index([matchId, type])
}

// ---------------------------------------------------------------------------
// Ingestion tracking
// ---------------------------------------------------------------------------

/**
 * One row per league — records the most recent fixture date ingested.
 * Used by seed-leagues.ts for incremental runs (skip already-seen fixtures).
 */
model IngestionCheckpoint {
  leagueExternalId Int       @id            // Sportmonks league ID
  lastFixtureDate  DateTime?               // starting_at of newest ingested fixture
  lastRunAt        DateTime  @updatedAt
}

/**
 * Persists API strategy detection results across deploys.
 * Replaces the file-based filter-support.json that evaporated on each Railway deploy.
 *
 * key examples:
 *   "fixtures_by_league_v3"      — which strategy works for /fixtures?league_id
 *   "endpoint_filters:/fixtures" — what filters /filters API reports for /fixtures
 */
model ApiStrategyCache {
  key       String   @id
  data      Json                  // StrategyEntry | EndpointFilterInfo
  expiresAt DateTime              // TTL — re-probe if now > expiresAt
  updatedAt DateTime @updatedAt
}

/**
 * Per-league capability profile — what data the API actually returns.
 *
 * Populated by detect-league-capabilities.ts (or auto-detected during ingest).
 * Used by the pipeline to skip unnecessary API calls:
 *   hasEvents=false  → skip /events fetching entirely
 *   hasCoordinates=false → disable spatial analytics (heatmap etc)
 *
 * tier:
 *   1 = Premium  (fixtures + events + coordinates)
 *   2 = Standard (fixtures + events, no coordinates)
 *   3 = Basic    (fixtures only)
 *
 * TTL: 7 days — re-detected automatically on next ingest run.
 */
model LeagueDataProfile {
  leagueId       Int      @id             // Sportmonks league ID
  hasFixtures    Boolean  @default(false)
  hasEvents      Boolean  @default(false)
  hasCoordinates Boolean  @default(false)
  tier           Int      @default(3)     // 1 | 2 | 3
  fixturesSample Int      @default(0)     // fixture count from detection run
  eventsSample   Int      @default(0)     // event count from probe fixture
  coordsSample   Int      @default(0)     // events-with-coords from probe
  checkedAt      DateTime @updatedAt

  @@index([tier])
  @@index([hasCoordinates])
  @@index([hasEvents])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisType {
  PLAYER_REPORT
  PLAYER_COMPARISON
}

enum AnalysisStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}
