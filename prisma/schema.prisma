generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  nameNormalized  String
  source          String   @default("manual")
  externalId      String?

  positions       String[]
  age             Int
  nationality     String

  team            String?
  league          String?
  imagePath       String?  @map("image_path")

  marketValue     Float?
  contractEnd     DateTime?

  overall         Int?
  potential       Int?

  attributes  Json
  archetype   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comparisonEntries  AnalysisComparison[]
  metricsSnapshots   PlayerMetrics[]
  financialSnapshots PlayerFinancials[]
  riskSnapshots      PlayerRiskSnapshot[]
  statsSnapshots     PlayerStats[]

  // Sportmonks team link (separate from denormalized `team` string above)
  teamDbId           String?
  dbTeam             Team?    @relation(fields: [teamDbId], references: [id])

  @@index([nameNormalized])
  @@index([league])
  @@index([team])
  @@index([overall(sort: Desc)])
  @@index([potential(sort: Desc)])
  @@index([source])
  @@unique([source, externalId])
  @@index([positions], type: Gin)
}

model PlayerMetrics {
  id         String   @id @default(uuid())
  playerId   String
  overall    Int
  potential  Int
  pace       Int
  shooting   Int
  passing    Int
  defending  Int
  physical   Int
  dribbling  Int?
  timestamp  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerFinancials {
  id                   String   @id @default(uuid())
  playerId             String
  marketValue          Float?
  salary               Float?
  transferCostEstimate Float?
  contractYears        Int?
  timestamp            DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerRiskSnapshot {
  id             String   @id @default(uuid())
  playerId       String
  structuralRisk Float
  financialRisk  Float
  liquidityScore Float
  compositeRisk  Float
  riskLevel      RiskLevel
  explanation    String?  @db.Text
  timestamp      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([riskLevel])
  @@index([timestamp])
}

model Analysis {
  id          String             @id @default(cuid())
  type        AnalysisType
  title       String
  description String?            @db.Text
  payload     Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  status      AnalysisStatus     @default(COMPLETED)
  analyst     String?

  comparisons AnalysisComparison[]

  @@index([type])
  @@index([createdAt])
  @@index([status])
}

model AnalysisComparison {
  id         String   @id @default(uuid())
  analysisId String
  playerId   String
  order      Int

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([playerId])
  @@unique([analysisId, order])
  @@unique([analysisId, playerId])
}

// ---------------------------------------------------------------------------
// Ingestion layer — Sportmonks raw data persistence
// ---------------------------------------------------------------------------

model Team {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks team ID
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  players    Player[]

  @@index([name])
}

model PlayerStats {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season      String?   // e.g. "2024/2025"
  source      String    @default("sportmonks") // sportmonks | manual

  goals         Int?
  assists       Int?
  shots         Int?
  shotsOnTarget Int?
  keyPasses     Int?
  passes        Int?
  passAccuracy  Float?
  xG            Float?
  xA            Float?
  tackles       Int?
  interceptions Int?
  pressures     Int?
  rating        Float?
  minutes       Int?
  appearances   Int?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([season])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisType {
  PLAYER_REPORT
  PLAYER_COMPARISON
}

enum AnalysisStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}
