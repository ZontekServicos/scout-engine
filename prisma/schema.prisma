generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core player/analysis models (existing — untouched)
// ---------------------------------------------------------------------------

model Player {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  nameNormalized  String
  source          String   @default("manual")
  externalId      String?

  positions       String[]
  age             Int
  nationality     String

  team            String?
  league          String?
  imagePath       String?  @map("image_path")

  marketValue     Float?
  contractEnd     DateTime?

  overall         Int?
  potential       Int?

  attributes  Json
  archetype   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comparisonEntries  AnalysisComparison[]
  metricsSnapshots   PlayerMetrics[]
  financialSnapshots PlayerFinancials[]
  riskSnapshots      PlayerRiskSnapshot[]
  statsSnapshots     PlayerStats[]
  matchEvents        MatchEvent[]

  // Sportmonks team link (separate from denormalized `team` string above)
  teamDbId           String?
  dbTeam             Team?    @relation(fields: [teamDbId], references: [id])

  @@index([nameNormalized])
  @@index([league])
  @@index([team])
  @@index([overall(sort: Desc)])
  @@index([potential(sort: Desc)])
  @@index([source])
  @@unique([source, externalId])
  @@index([positions], type: Gin)
}

model PlayerMetrics {
  id         String   @id @default(uuid())
  playerId   String
  overall    Int
  potential  Int
  pace       Int
  shooting   Int
  passing    Int
  defending  Int
  physical   Int
  dribbling  Int?
  timestamp  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerFinancials {
  id                   String   @id @default(uuid())
  playerId             String
  marketValue          Float?
  salary               Float?
  transferCostEstimate Float?
  contractYears        Int?
  timestamp            DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerRiskSnapshot {
  id             String   @id @default(uuid())
  playerId       String
  structuralRisk Float
  financialRisk  Float
  liquidityScore Float
  compositeRisk  Float
  riskLevel      RiskLevel
  explanation    String?  @db.Text
  timestamp      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([riskLevel])
  @@index([timestamp])
}

model Analysis {
  id          String             @id @default(cuid())
  type        AnalysisType
  title       String
  description String?            @db.Text
  payload     Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  status      AnalysisStatus     @default(COMPLETED)
  analyst     String?

  comparisons AnalysisComparison[]

  @@index([type])
  @@index([createdAt])
  @@index([status])
}

model AnalysisComparison {
  id         String   @id @default(uuid())
  analysisId String
  playerId   String
  order      Int

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([playerId])
  @@unique([analysisId, order])
  @@unique([analysisId, playerId])
}

// ---------------------------------------------------------------------------
// Ingestion hierarchy — Country → League → Season → Team → Player
// ---------------------------------------------------------------------------

model Country {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks country ID
  name       String
  iso2       String?
  flagPath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leagues    League[]

  @@index([name])
}

model League {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks league ID
  name       String
  countryId  String?
  country    Country? @relation(fields: [countryId], references: [id])
  type       String?  // e.g. "domestic", "cup", "continental"
  logoPath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seasons    Season[]

  @@index([name])
  @@index([countryId])
}

model Season {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks season ID
  name       String
  leagueId   String?
  league     League?  @relation(fields: [leagueId], references: [id])
  year       Int?
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teams        Team[]        @relation("SeasonTeams")
  matches      Match[]
  playerStats  PlayerStats[]

  @@index([leagueId])
  @@index([isCurrent])
  @@index([year])
}

model Team {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks team ID
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  players     Player[]
  seasons     Season[]    @relation("SeasonTeams")
  homeMatches Match[]     @relation("HomeMatches")
  awayMatches Match[]     @relation("AwayMatches")
  matchEvents MatchEvent[] @relation("TeamMatchEvents")

  @@index([name])
}

model PlayerStats {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Link to structured Season (optional — backward compatible with old string `season`)
  seasonId    String?
  dbSeason    Season?  @relation(fields: [seasonId], references: [id])
  season      String?  // denormalized label e.g. "2024/2025" — kept for compatibility

  source      String   @default("sportmonks") // sportmonks | manual

  goals         Int?
  assists       Int?
  shots         Int?
  shotsOnTarget Int?
  keyPasses     Int?
  passes        Int?
  passAccuracy  Float?
  xG            Float?
  xA            Float?
  tackles       Int?
  interceptions Int?
  pressures     Int?
  rating        Float?
  minutes       Int?
  appearances   Int?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([seasonId])
  @@index([season])
}

// ---------------------------------------------------------------------------
// Match layer — Season → Match → MatchEvent
// ---------------------------------------------------------------------------

model Match {
  id         String   @id @default(uuid())
  externalId Int      @unique // Sportmonks fixture ID
  seasonId   String?
  season     Season?  @relation(fields: [seasonId], references: [id])

  homeTeamId String?
  homeTeam   Team?    @relation("HomeMatches", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?    @relation("AwayMatches", fields: [awayTeamId], references: [id])

  homeScore  Int?
  awayScore  Int?
  startingAt DateTime?
  status     String?  // e.g. "FT", "NS", "LIVE", "HT"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events     MatchEvent[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([startingAt])
  @@index([status])
}

model MatchEvent {
  id         String  @id @default(uuid())
  externalId Int?    @unique // Sportmonks event ID (nullable — some events are synthetic)

  matchId    String
  match      Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId   String?
  player     Player? @relation(fields: [playerId], references: [id])

  teamId     String?
  team       Team?   @relation("TeamMatchEvents", fields: [teamId], references: [id])

  // Event classification
  type       String  // GOAL | SHOT | PASS | TACKLE | INTERCEPTION | DRIBBLE |
                     // YELLOW_CARD | RED_CARD | SUBSTITUTION | FOUL | SAVE | CLEARANCE

  // Timing
  minute      Int?
  extraMinute Int?

  // Spatial data — pitch coordinates normalised to 0–100
  // Used for: heatmap, shot map, pass map, defensive event map
  x    Float?  // start x (0=left, 100=right)
  y    Float?  // start y (0=bottom, 100=top)
  endX Float?  // end x (for passes, shots, dribbles)
  endY Float?  // end y

  // Outcome
  outcome String? // SUCCESS | FAIL | BLOCKED | SAVED | OFF_TARGET | ON_TARGET

  // Extra unstructured data (body part, assist type, VAR, etc.)
  meta Json?

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type])
  @@index([minute])
  // Composite index for spatial queries (heatmap per player/type)
  @@index([playerId, type])
  @@index([matchId, type])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisType {
  PLAYER_REPORT
  PLAYER_COMPARISON
}

enum AnalysisStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}
