generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  nameNormalized  String
  source          String   @default("manual")
  externalId      String?

  positions       String[]
  age             Int
  nationality     String

  team            String?
  league          String?
  imagePath       String?  @map("image_path")

  marketValue     Float?
  contractEnd     DateTime?

  overall         Int?
  potential       Int?

  attributes  Json
  archetype   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scoutReports       ScoutReport[]
  comparisonEntries  AnalysisComparison[]
  metricsSnapshots   PlayerMetrics[]
  financialSnapshots PlayerFinancials[]
  riskSnapshots      PlayerRiskSnapshot[]

  @@index([nameNormalized])
  @@index([league])
  @@index([team])
  @@index([overall(sort: Desc)])
  @@index([potential(sort: Desc)])
  @@index([source])
  @@unique([source, externalId])
  @@index([positions], type: Gin)
}

model PlayerMetrics {
  id        String   @id @default(uuid())
  playerId   String
  overall    Int
  potential  Int
  pace       Int
  shooting   Int
  passing    Int
  defending  Int
  physical   Int
  dribbling  Int?
  timestamp  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerFinancials {
  id                   String   @id @default(uuid())
  playerId             String
  marketValue          Float?
  salary               Float?
  transferCostEstimate Float?
  contractYears        Int?
  timestamp            DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([timestamp])
}

model PlayerRiskSnapshot {
  id             String    @id @default(uuid())
  playerId       String
  structuralRisk Float
  financialRisk  Float
  liquidityScore Float
  compositeRisk  Float
  riskLevel      RiskLevel
  explanation    String?   @db.Text
  timestamp      DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([riskLevel])
  @@index([timestamp])
}

model ScoutReport {
  id          String   @id @default(uuid())
  playerId    String
  type        ScoutType

  input       Json
  output      Json
  risk        Json?
  aiNarrative String?  @db.Text

  // 🔵 GOVERNANÇA & AUDITORIA
  requestedBy     String?
  decisionBy      String?
  decisionReason  String? @db.Text
  decisionDate    DateTime?
  modelVersion    String?
  riskVersion     String?
  antiFlopVersion String?
  engineVersion   String?
  technicalReason String? @db.Text
  decisionStatus  DecisionStatus @default(PENDING)
  decisionAt      DateTime?

  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  analysis Analysis?

  @@index([playerId])
  @@index([type])
  @@index([createdAt])
  @@index([decisionStatus])
}

model Analysis {
  id            String               @id @default(uuid())
  type          AnalysisType
  title         String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  status        AnalysisStatus       @default(COMPLETED)
  analyst       String?
  scoutReportId String?              @unique @map("scout_report_id")

  scoutReport   ScoutReport?         @relation(fields: [scoutReportId], references: [id], onDelete: SetNull)
  comparisons   AnalysisComparison[]

  @@index([type])
  @@index([createdAt])
  @@index([status])
}

model AnalysisComparison {
  id         String   @id @default(uuid())
  analysisId String
  playerId   String
  order      Int

  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([playerId])
  @@unique([analysisId, order])
  @@unique([analysisId, playerId])
}

enum ScoutType {
  SINGLE
  COMPARE
  RANKING
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisType {
  COMPARISON
  REPORT
}

enum AnalysisStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}
